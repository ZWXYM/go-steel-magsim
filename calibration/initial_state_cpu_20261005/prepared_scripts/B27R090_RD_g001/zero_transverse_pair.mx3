// Grain 1 simulation - 0 degree direction
// Euler angles: phi1=5.33, Phi=45.04, phi2=0.68
// Material: Fe-3.1%Si
// Applied field angle: 0 degrees (in sample frame)
// Physics version: cubic_sample_frame_v2

// ============================================
// Grid settings - Single grain RVE
// ============================================
// RVE size: 0.016 um x 0.016 um x 0.001 um
SetGridSize(4, 4, 1)
SetCellSize(4.00e-09, 4.00e-09, 1.00e-09)

// ============================================
// Fe-Si material parameters
// ============================================
Msat = 1.56e+06     // Saturation magnetization (A/m)
Aex = 2.10e-11        // Exchange constant (J/m)
alpha = 0.010    // Gilbert damping

// ============================================
// Cubic anisotropy (Fe-Si crystal)
// ============================================
// Energy: E = Ku1 * (α1²α2² + α2²α3² + α3²α1²) + Ku2 * (α1²α2²α3²)
// The simulation xyz axes correspond to crystal <100>, <010>, <001> directions

Kc1 = 3.56e+04        // First cubic anisotropy constant (J/m³)
Kc2 = 0
Ku1 = 0                      // No uniaxial anisotropy in this model
anisC1 = vector(0.9948377951, 0.1011342297, 0.0083444056)
anisC2 = vector(-0.0773447991, 0.7024497009, 0.7075183389)

// ============================================
// Crystal orientation information
// ============================================
// Crystal axes in sample frame:
// <100>: (0.994838, 0.101134, 0.008344)
// <010>: (-0.077345, 0.702450, 0.707518)
// <001>: (0.065693, -0.704511, 0.706646)

// ============================================
// Field direction in SAMPLE frame
// ============================================
// Sample frame: angle = 0° → (1.000000, 0.000000, 0.000000)
// Sample frame: (1.000000, 0.000000, 0.000000)

H_max := 50000.0   // Maximum field magnitude (A/m)
n_steps := 150   // Steps per segment

// Field direction unit vector in sample coordinates
Hx_dir := 1.0000000000
Hy_dir := 0.0000000000
Hz_dir := 0.0000000000

// ============================================

// Diagnostic only: not a measured normal curve or training label.
MinimizerStop = 1e-7
MinimizerSamples = 20
tableadd(B_ext)
tableadd(m)
tableadd(E_total)
tableadd(maxTorque)
state_phase := 0.0
tableaddvar(state_phase, "state_phase", "")
H := 0.0
state_phase = -2.0
B_ext = vector(0, 0, 0)
m = uniform(1.0*Hy_dir, -1.0*Hx_dir, 0)
// Two opposite transverse initializations; neither is certified demagnetization.
H = 0
B_ext = vector(mu0*H*Hx_dir, mu0*H*Hy_dir, mu0*H*Hz_dir)
minimize()
tablesave()
